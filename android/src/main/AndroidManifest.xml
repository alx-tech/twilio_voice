<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL"/>
    <!-- Routing call audio to a paired headset. BLUETOOTH_CONNECT is a runtime
         permission from API 31, so the host app must also request it; declaring it
         here only makes the request possible. BLUETOOTH covers the pre-31
         startBluetoothSco path and is implicit from 31 onwards. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>

    <application>
        <!-- Both types are declared because startForeground() may only pass a type
             declared here: phoneCall while ringing (it is exempt from the Android 14+
             while-in-use background-start restriction), plus microphone once the call
             is connected and the mic is actually in use. -->
        <service
            android:name=".service.TVConnectionService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone"
            android:label="@string/connection_service_name" />

        <!-- Deliberately NOT excludeFromRecents: this Activity is the in-call screen as
             well as the ringing one, and a rep who leaves a live call needs the ordinary
             ways back to it. A finished call takes its task out of recents with it. -->
        <activity
            android:name=".activities.TVIncomingCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/IncomingCallTheme" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

</manifest>
